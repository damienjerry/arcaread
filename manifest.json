{
  "manifest_version": 3,
  "name": "BionicRead",
  "version": "0.1.0",
  "description": "Bold the first half of each word to speed up reading. Works on any page.",
  "permissions": ["storage", "activeTab", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BionicRead"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*", "vendor/*", "viewer.html", "viewer.js", "core.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
